rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // User is a member of the given household
    function isMember(hid) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Households — anyone authenticated can read (to check join codes)
    // Only members can update (to add members)
    // Only authenticated users can create
    match /households/{hhId} {
      allow read:   if isAuth();
      allow create: if isAuth() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.members[0] == request.auth.uid;
      allow update: if isAuth() &&
                       request.auth.uid in resource.data.members;
      allow delete: if isAuth() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // Users — each user can read/write their own doc
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // All household-scoped collections
    match /transactions/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }

    match /categories/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }

    match /budgetPlans/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }

    match /goals/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }

    match /bills/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }

    match /accounts/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }

    match /settings/{docId} {
      allow read, write: if isMember(resource.data.householdId);
      allow create:      if isMember(request.resource.data.householdId);
    }
  }
}
